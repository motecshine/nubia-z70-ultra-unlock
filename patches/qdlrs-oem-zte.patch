+pub fn probe_gpt<T: QdlChan>(channel: &mut T, slot: u8) -> Result<()> {
+    use std::io::sink;
+
+    // Try reading 1 sector at sector 1 (GPT header) across sector sizes and LUNs
+    for sector_size in [4096usize, 512] {
+        channel.mut_fh_config().storage_sector_size = sector_size;
+        for phys_part_idx in 0..=6u8 {
+            let r = qdl::firehose_read_storage(channel, &mut sink(), 1, slot, phys_part_idx, 1);
+            match r {
+                Ok(_) => println!(
+                    "{} READ OK: sector_size={} LUN={} start_sector=1",
+                    "[OK]".green(),
+                    sector_size,
+                    phys_part_idx
+                ),
+                Err(e) => println!(
+                    "READ FAIL: sector_size={} LUN={} => {}",
+                    sector_size, phys_part_idx, e
+                ),
+            }
+        }
+    }
+    Ok(())
+}
