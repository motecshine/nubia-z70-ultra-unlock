+pub fn backup_critical<T: QdlChan>(channel: &mut T, outdir: &str) -> Result<()> {
+    let outpath = std::path::Path::new(outdir);
+    std::fs::create_dir_all(outpath)?;
+
+    // 关键分区列表 (当前槽位 _a)
+    let lun4_parts: &[&str] = &[
+        "uefi_a",
+        "abl_a",
+        "boot_a",
+        "vbmeta_a",
+        "init_boot_a",
+        "dtbo_a",
+        "aop_a",
+        "aop_config_a",
+        "tz_a",
+        "hyp_a",
+        "keymaster_a",
+        "devcfg_a",
+        "qupfw_a",
+        "cpucp_a",
+        "cpucp_dtb_a",
+        "featenabler_a",
+        "uefisecapp_a",
+        "imagefv_a",
+        "shrm_a",
+        "bluetooth_a",
+        "dsp_a",
+        "recovery_a",
+        "vendor_boot_a",
+        "pvmfw_a",
+        "splash_a",
+        // 基带相关
+        "modem_a",
+        "modem_b",
+        "devinfo",
+        "toolsfv",
+        "logfs",
+        "storsec",
+        "uefivarstore",
+        "secdata",
+    ];
+    let lun1_parts: &[&str] = &[
+        "xbl_a",
+        "xbl_config_a",
+        "multiimgqti_a",
+        "multiimgoem_a",
+        "apdp",
+        "last_parti",
+    ];
+    let lun0_parts: &[&str] = &[
+        "ssd",
+        "persist",
+        "misc",
+        "parameter",
+        "keystore",
+        "frp",
+    ];
+    // 在 LUN2/3 里的启动链分区
+    let lun2_parts: &[&str] = &[
+        "xbl_b",
+        "xbl_config_b",
+        "multiimgqti_b",
+        "multiimgoem_b",
+        "apdpb",
+    ];
+    let lun3_parts: &[&str] = &[
+        "ALIGN_TO_128K_1",
+        "cdt",
+        "ddr",
+    ];
+
+    for (lun, parts) in [
+        (4u8, lun4_parts),
+        (1u8, lun1_parts),
+        (2u8, lun2_parts),
+        (3u8, lun3_parts),
+        (0u8, lun0_parts),
+    ] {
+        // 保存原始 GPT (前 1024 扇区, 足够覆盖 GPT 表)
+        println!("--- LUN{}: 保存原始 GPT ---", lun);
+        {
+            if let Ok(mut gptbin) = std::fs::File::create(outpath.join(format!("gpt_raw_lun{}.bin", lun))) {
+                if let Err(e) = qdl::firehose_read_storage(channel, &mut gptbin, 1024, 0, lun, 0) {
+                    println!("[WARN] LUN{} GPT 读取失败: {}", lun, e);
+                }
+            }
+        }
+
+        for name in parts {
+            let mut f = match std::fs::File::create(outpath.join(format!("L{}__{}.img", lun, name))) {
+                Ok(f) => f,
+                Err(e) => {
+                    println!("[SKIP] {} (LUN{}): {}", name, lun, e);
+                    continue;
+                }
+            };
+            match read_storage_logical_partition(channel, &mut f, name, 0, lun) {
+                Ok(_) => println!("[OK]   {} (LUN{})", name, lun),
+                Err(e) => println!("[SKIP] {} (LUN{}): {}", name, lun, e),
+            }
+        }
+    }
+    Ok(())
+}
